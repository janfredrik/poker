# Image built by GitHub Actions (ghcr.io/<github-user>/<repo>:latest)
POKER_IMAGE=ghcr.io/janfredrik/poker:latest
# Host port nginx proxies to
POKER_PORT=3000
# Where tables, ledgers and saved rule sets are stored (Unraid: /mnt/user/appdata/poker)
DATA_PATH=./data
TZ=Europe/Oslo
# Container user. Unraid appdata is usually owned by nobody:users = 99:100
PUID=99
PGID=100

# --- Video relay: Cloudflare Realtime TURN (dash.cloudflare.com > Realtime > TURN Server) ---
# Without these, video still works peer-to-peer for most players, just without a relay.
# Key ID and API token of the TURN key. Server-side only; browsers get short-lived credentials.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# --- Monthly usage alerts (1 000 GB/month included, then $0.05/GB) ---
# Account ID (dashboard URL / account home) and an API token with Account > Account Analytics > Read.
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Where alerts are POSTed: a Home Assistant webhook, Discord/Slack webhook, ntfy topic, ...
ALERT_WEBHOOK_URL=
# json (Home Assistant, Discord, Slack) or text (ntfy)
ALERT_WEBHOOK_FORMAT=json
# Alert at these percentages of the allowance, and always at 100 %
TURN_WARN_PERCENT=50,80,95
TURN_MONTHLY_GB=1000
# Stop handing out TURN credentials once the allowance is used up (direct video keeps working)
TURN_STOP_AT_LIMIT=true
# Day of the month your Cloudflare billing period starts
TURN_BILLING_DAY=1
