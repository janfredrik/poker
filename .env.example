# Image built by GitHub Actions (ghcr.io/<github-user>/<repo>:latest)
POKER_IMAGE=ghcr.io/janfredrik/poker:latest
# Public hostname your friends use, e.g. poker.example.com (may be proxied by Cloudflare)
PUBLIC_HOST=poker.example.com
# Hostname for STUN/TURN. Must resolve straight to your WAN IP: with Cloudflare,
# make it a DNS-only (grey cloud) A record, since Cloudflare's proxy does not carry UDP.
# Leave empty to reuse PUBLIC_HOST (only if PUBLIC_HOST is not proxied).
TURN_HOST=turn.example.com
# Your public (WAN) IP address, needed by coturn behind NAT
PUBLIC_IP=203.0.113.10
# Long random string shared by the poker server and coturn: openssl rand -hex 32
TURN_SECRET=change-me
# Host port nginx proxies to
POKER_PORT=3000
# Where tables, ledgers and saved rule sets are stored (Unraid: /mnt/user/appdata/homegame)
DATA_PATH=./data
TZ=Europe/Oslo
# Container user. Unraid appdata is usually owned by nobody:users = 99:100
PUID=99
PGID=100
